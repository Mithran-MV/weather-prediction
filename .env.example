# ---------------------------------------------------------------------------
# WeatherAPI.com credentials
# ---------------------------------------------------------------------------
# Grab a free key at https://www.weatherapi.com/signup.aspx
#
# NOTE: this is intentionally NOT prefixed with NEXT_PUBLIC_. The key is read
# only inside server-side route handlers (src/app/api/**), so it is never
# shipped to the browser bundle and never appears in network requests made by
# the client.
WEATHER_API_KEY=your_weatherapi_key_here

# Optional. Defaults to https://api.weatherapi.com/v1
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1

# Optional. Location the dashboard opens on before the user picks one.
# Accepts "City", "City,Country" or "lat,lon".
NEXT_PUBLIC_DEFAULT_LOCATION=Sriperumbudur

# Optional. Absolute URL of the deployment, used for OpenGraph + sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
